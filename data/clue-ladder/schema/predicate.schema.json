{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$ref": "#/definitions/Predicate",
  "definitions": {
    "Predicate": {
      "anyOf": [
        {
          "type": "object",
          "properties": {
            "metricId": {
              "type": "string"
            },
            "op": {
              "type": "string",
              "enum": [
                "eq",
                "lt",
                "lte",
                "gt",
                "gte"
              ]
            },
            "value": {
              "$ref": "#/definitions/FactValue"
            }
          },
          "required": [
            "metricId",
            "op",
            "value"
          ],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "metricId": {
              "type": "string"
            },
            "op": {
              "type": "string",
              "const": "between"
            },
            "minInclusive": {
              "type": "number"
            },
            "maxExclusive": {
              "type": "number"
            }
          },
          "required": [
            "metricId",
            "op",
            "minInclusive",
            "maxExclusive"
          ],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "metricId": {
              "type": "string"
            },
            "op": {
              "type": "string",
              "const": "contains_all"
            },
            "values": {
              "type": "array",
              "items": {
                "type": "string"
              }
            }
          },
          "required": [
            "metricId",
            "op",
            "values"
          ],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "all": {
              "type": "array",
              "items": {
                "$ref": "#/definitions/Predicate"
              }
            }
          },
          "required": [
            "all"
          ],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "any": {
              "type": "array",
              "items": {
                "$ref": "#/definitions/Predicate"
              }
            }
          },
          "required": [
            "any"
          ],
          "additionalProperties": false
        }
      ]
    },
    "FactValue": {
      "anyOf": [
        {
          "type": "null"
        },
        {
          "type": "number"
        },
        {
          "type": "string"
        },
        {
          "type": "boolean"
        },
        {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        {
          "type": "object",
          "additionalProperties": {}
        }
      ]
    }
  }
}
