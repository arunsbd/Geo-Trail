{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$ref": "#/definitions/ParkAssociation",
  "definitions": {
    "ParkAssociation": {
      "type": "object",
      "properties": {
        "associationId": {
          "type": "string"
        },
        "stateId": {
          "$ref": "#/definitions/StateId"
        },
        "npsUnitId": {
          "type": "string"
        },
        "unitName": {
          "type": "string"
        },
        "formalDesignation": {
          "type": "string"
        },
        "isFormallyNationalPark": {
          "type": "boolean"
        },
        "relationship": {
          "type": "string",
          "enum": [
            "inside",
            "partly_inside",
            "trail_crosses",
            "administrative_association"
          ]
        },
        "sourceRefs": {
          "type": "array",
          "items": {
            "$ref": "#/definitions/SourceLocator"
          }
        },
        "snapshotId": {
          "type": "string"
        }
      },
      "required": [
        "associationId",
        "stateId",
        "npsUnitId",
        "unitName",
        "formalDesignation",
        "isFormallyNationalPark",
        "relationship",
        "sourceRefs",
        "snapshotId"
      ],
      "additionalProperties": false
    },
    "StateId": {
      "type": "string",
      "enum": [
        "US-AL",
        "US-AK",
        "US-AZ",
        "US-AR",
        "US-CA",
        "US-CO",
        "US-CT",
        "US-DE",
        "US-FL",
        "US-GA",
        "US-HI",
        "US-ID",
        "US-IL",
        "US-IN",
        "US-IA",
        "US-KS",
        "US-KY",
        "US-LA",
        "US-ME",
        "US-MD",
        "US-MA",
        "US-MI",
        "US-MN",
        "US-MS",
        "US-MO",
        "US-MT",
        "US-NE",
        "US-NV",
        "US-NH",
        "US-NJ",
        "US-NM",
        "US-NY",
        "US-NC",
        "US-ND",
        "US-OH",
        "US-OK",
        "US-OR",
        "US-PA",
        "US-RI",
        "US-SC",
        "US-SD",
        "US-TN",
        "US-TX",
        "US-UT",
        "US-VT",
        "US-VA",
        "US-WA",
        "US-WV",
        "US-WI",
        "US-WY"
      ]
    },
    "SourceLocator": {
      "type": "object",
      "properties": {
        "sourceId": {
          "$ref": "#/definitions/SourceId"
        },
        "sheet": {
          "type": "string"
        },
        "table": {
          "type": "string"
        },
        "rowKey": {
          "type": "string"
        },
        "column": {
          "type": "string"
        },
        "variableCode": {
          "type": "string"
        },
        "page": {
          "type": "number"
        },
        "section": {
          "type": "string"
        },
        "featureId": {
          "type": "string"
        }
      },
      "required": [
        "sourceId"
      ],
      "additionalProperties": false
    },
    "SourceId": {
      "type": "string"
    }
  }
}
