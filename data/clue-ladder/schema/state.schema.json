{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$ref": "#/definitions/StateRecord",
  "definitions": {
    "StateRecord": {
      "type": "object",
      "properties": {
        "stateId": {
          "$ref": "#/definitions/StateId"
        },
        "name": {
          "type": "string"
        },
        "slug": {
          "type": "string"
        },
        "postalCode": {
          "type": "string"
        },
        "censusFips": {
          "type": "string"
        },
        "censusRegion": {
          "type": "string"
        },
        "censusDivision": {
          "type": "string"
        },
        "mapAssetId": {
          "$ref": "#/definitions/AssetId"
        },
        "identitySourceRefs": {
          "type": "array",
          "items": {
            "$ref": "#/definitions/SourceLocator"
          }
        }
      },
      "required": [
        "stateId",
        "name",
        "slug",
        "postalCode",
        "censusFips",
        "censusRegion",
        "censusDivision",
        "mapAssetId",
        "identitySourceRefs"
      ],
      "additionalProperties": false
    },
    "StateId": {
      "type": "string",
      "enum": [
        "US-AL",
        "US-AK",
        "US-AZ",
        "US-AR",
        "US-CA",
        "US-CO",
        "US-CT",
        "US-DE",
        "US-FL",
        "US-GA",
        "US-HI",
        "US-ID",
        "US-IL",
        "US-IN",
        "US-IA",
        "US-KS",
        "US-KY",
        "US-LA",
        "US-ME",
        "US-MD",
        "US-MA",
        "US-MI",
        "US-MN",
        "US-MS",
        "US-MO",
        "US-MT",
        "US-NE",
        "US-NV",
        "US-NH",
        "US-NJ",
        "US-NM",
        "US-NY",
        "US-NC",
        "US-ND",
        "US-OH",
        "US-OK",
        "US-OR",
        "US-PA",
        "US-RI",
        "US-SC",
        "US-SD",
        "US-TN",
        "US-TX",
        "US-UT",
        "US-VT",
        "US-VA",
        "US-WA",
        "US-WV",
        "US-WI",
        "US-WY"
      ]
    },
    "AssetId": {
      "type": "string"
    },
    "SourceLocator": {
      "type": "object",
      "properties": {
        "sourceId": {
          "$ref": "#/definitions/SourceId"
        },
        "sheet": {
          "type": "string"
        },
        "table": {
          "type": "string"
        },
        "rowKey": {
          "type": "string"
        },
        "column": {
          "type": "string"
        },
        "variableCode": {
          "type": "string"
        },
        "page": {
          "type": "number"
        },
        "section": {
          "type": "string"
        },
        "featureId": {
          "type": "string"
        }
      },
      "required": [
        "sourceId"
      ],
      "additionalProperties": false
    },
    "SourceId": {
      "type": "string"
    }
  }
}
