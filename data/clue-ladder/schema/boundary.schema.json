{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$ref": "#/definitions/BoundaryRecord",
  "definitions": {
    "BoundaryRecord": {
      "type": "object",
      "properties": {
        "boundaryId": {
          "type": "string"
        },
        "stateA": {
          "$ref": "#/definitions/StateId"
        },
        "stateB": {
          "$ref": "#/definitions/StateId"
        },
        "topology": {
          "type": "string",
          "enum": [
            "segment",
            "point_contact"
          ]
        },
        "medium": {
          "type": "string",
          "enum": [
            "land",
            "river",
            "lake_or_coastal_water"
          ]
        },
        "clueBorderEligible": {
          "type": "boolean"
        },
        "borderHuntEdge": {
          "type": "boolean"
        },
        "sourceGeometryId": {
          "$ref": "#/definitions/SourceId"
        },
        "derivation": {
          "type": "object",
          "properties": {
            "method": {
              "type": "string",
              "const": "spatial_intersection"
            },
            "toleranceMeters": {
              "type": "number"
            },
            "codeVersion": {
              "type": "string"
            }
          },
          "required": [
            "method",
            "toleranceMeters",
            "codeVersion"
          ],
          "additionalProperties": false
        },
        "reviewerNotes": {
          "type": "string"
        }
      },
      "required": [
        "boundaryId",
        "stateA",
        "stateB",
        "topology",
        "medium",
        "clueBorderEligible",
        "borderHuntEdge",
        "sourceGeometryId",
        "derivation"
      ],
      "additionalProperties": false
    },
    "StateId": {
      "type": "string",
      "enum": [
        "US-AL",
        "US-AK",
        "US-AZ",
        "US-AR",
        "US-CA",
        "US-CO",
        "US-CT",
        "US-DE",
        "US-FL",
        "US-GA",
        "US-HI",
        "US-ID",
        "US-IL",
        "US-IN",
        "US-IA",
        "US-KS",
        "US-KY",
        "US-LA",
        "US-ME",
        "US-MD",
        "US-MA",
        "US-MI",
        "US-MN",
        "US-MS",
        "US-MO",
        "US-MT",
        "US-NE",
        "US-NV",
        "US-NH",
        "US-NJ",
        "US-NM",
        "US-NY",
        "US-NC",
        "US-ND",
        "US-OH",
        "US-OK",
        "US-OR",
        "US-PA",
        "US-RI",
        "US-SC",
        "US-SD",
        "US-TN",
        "US-TX",
        "US-UT",
        "US-VT",
        "US-VA",
        "US-WA",
        "US-WV",
        "US-WI",
        "US-WY"
      ]
    },
    "SourceId": {
      "type": "string"
    }
  }
}
