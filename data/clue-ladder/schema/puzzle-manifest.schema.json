{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$ref": "#/definitions/PuzzleManifest",
  "definitions": {
    "PuzzleManifest": {
      "type": "object",
      "properties": {
        "dataContentSha256": {
          "type": "string"
        },
        "puzzleId": {
          "type": "string"
        },
        "mode": {
          "type": "string",
          "const": "clue_ladder"
        },
        "date": {
          "type": "string"
        },
        "answerStateId": {
          "$ref": "#/definitions/StateId"
        },
        "orderedClueIds": {
          "type": "array",
          "items": {
            "$ref": "#/definitions/ClueId"
          }
        },
        "dataSnapshotId": {
          "type": "string"
        },
        "clueSetVersion": {
          "type": "string"
        },
        "scoring": {
          "type": "object",
          "properties": {
            "maxByRung": {
              "type": "array",
              "items": {
                "type": "number"
              }
            },
            "wrongGuessPenalty": {
              "type": "number"
            }
          },
          "required": [
            "maxByRung",
            "wrongGuessPenalty"
          ],
          "additionalProperties": false
        },
        "seed": {
          "type": "string"
        },
        "generatedAt": {
          "type": "string"
        },
        "validatorVersion": {
          "type": "string"
        }
      },
      "required": [
        "dataContentSha256",
        "puzzleId",
        "mode",
        "answerStateId",
        "orderedClueIds",
        "dataSnapshotId",
        "clueSetVersion",
        "scoring",
        "generatedAt",
        "validatorVersion"
      ],
      "additionalProperties": false
    },
    "StateId": {
      "type": "string",
      "enum": [
        "US-AL",
        "US-AK",
        "US-AZ",
        "US-AR",
        "US-CA",
        "US-CO",
        "US-CT",
        "US-DE",
        "US-FL",
        "US-GA",
        "US-HI",
        "US-ID",
        "US-IL",
        "US-IN",
        "US-IA",
        "US-KS",
        "US-KY",
        "US-LA",
        "US-ME",
        "US-MD",
        "US-MA",
        "US-MI",
        "US-MN",
        "US-MS",
        "US-MO",
        "US-MT",
        "US-NE",
        "US-NV",
        "US-NH",
        "US-NJ",
        "US-NM",
        "US-NY",
        "US-NC",
        "US-ND",
        "US-OH",
        "US-OK",
        "US-OR",
        "US-PA",
        "US-RI",
        "US-SC",
        "US-SD",
        "US-TN",
        "US-TX",
        "US-UT",
        "US-VT",
        "US-VA",
        "US-WA",
        "US-WV",
        "US-WI",
        "US-WY"
      ]
    },
    "ClueId": {
      "type": "string"
    }
  }
}
